{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile and non-secret workspace preferences stored per Google account.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name from Google Sign-In or profile."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified email address from Google Sign-In."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512,
          "description": "Optional avatar URL from Google Sign-In."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "maxLength": 10,
          "description": "Desktop Fluent theme preference."
        },
        "preferredProvider": {
          "type": "string",
          "enum": ["openai", "openrouter", "anthropic", "groq", "deepseek", "ollama", "custom"],
          "maxLength": 32,
          "description": "Preferred BYOK LLM provider identifier (no secret keys stored)."
        },
        "preferredModel": {
          "type": "string",
          "maxLength": 120,
          "description": "Preferred model name for the configured endpoint."
        },
        "preferredBaseUrl": {
          "type": "string",
          "maxLength": 256,
          "description": "Preferred non-secret endpoint base URL."
        },
        "monthlyBudgetUsd": {
          "type": "number",
          "description": "Monthly spend cap in USD."
        },
        "monthlyTokenLimit": {
          "type": "number",
          "description": "Monthly token usage limit."
        },
        "activeProjectId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$",
          "description": "Last active workspace repository ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "theme",
        "preferredProvider",
        "preferredModel",
        "preferredBaseUrl",
        "monthlyBudgetUsd",
        "monthlyTokenLimit",
        "activeProjectId",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserExtensionPref": {
      "title": "UserExtensionPref",
      "description": "Per-user persisted extension installation and activation preference.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID."
        },
        "extensionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9._\\-]+$",
          "description": "Canonical extension identifier (e.g. devmind.code-formatter)."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Extension display name."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Installed extension version."
        },
        "installed": {
          "type": "boolean",
          "description": "Whether the extension is installed for this user."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the extension is currently enabled."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when first persisted."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest toggle or install."
        }
      },
      "required": [
        "ownerId",
        "extensionId",
        "displayName",
        "version",
        "installed",
        "enabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserTaskRecord": {
      "title": "UserTaskRecord",
      "description": "Per-user persisted engineering task metadata, priority, status, and spend record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID."
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated workspace repository ID."
        },
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Associated repository name."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Task title."
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "description": "Task prompt or summary."
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "maxLength": 16,
          "description": "Task priority level."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "planning", "awaiting_approval", "running", "completed", "failed", "cancelled"],
          "maxLength": 32,
          "description": "Current execution lifecycle status."
        },
        "executionMode": {
          "type": "string",
          "enum": ["approval", "direct"],
          "maxLength": 16,
          "description": "Policy mode under which the task ran."
        },
        "modelName": {
          "type": "string",
          "maxLength": 120,
          "description": "Model identifier used for the task."
        },
        "actualCostUsd": {
          "type": "number",
          "description": "Actual token spend in USD."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of task creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "ownerId",
        "projectId",
        "projectName",
        "title",
        "description",
        "priority",
        "status",
        "executionMode",
        "modelName",
        "actualCostUsd",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProjectSummary": {
      "title": "UserProjectSummary",
      "description": "Per-user persisted workspace repository metadata.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Repository name."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Repository description."
        },
        "localPath": {
          "type": "string",
          "maxLength": 260,
          "description": "Local Windows workspace path."
        },
        "framework": {
          "type": "string",
          "maxLength": 80,
          "description": "Detected framework."
        },
        "primaryLanguage": {
          "type": "string",
          "maxLength": 40,
          "description": "Primary language."
        },
        "fileCount": {
          "type": "number",
          "description": "Indexed file count."
        },
        "symbolCount": {
          "type": "number",
          "description": "Indexed AST symbol count."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when first synced."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest index sync."
        }
      },
      "required": [
        "ownerId",
        "name",
        "description",
        "localPath",
        "framework",
        "primaryLanguage",
        "fileCount",
        "symbolCount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and non-secret workspace preferences isolated strictly to the owning verified Google user."
    },
    "/users/{userId}/extensions/{extensionDocId}": {
      "schema": { "$ref": "#/entities/UserExtensionPref" },
      "description": "Per-user installed and enabled extension state synchronized across sessions."
    },
    "/users/{userId}/taskRecords/{taskId}": {
      "schema": { "$ref": "#/entities/UserTaskRecord" },
      "description": "Per-user engineering task history records with priority and execution status."
    },
    "/users/{userId}/savedProjects/{projectId}": {
      "schema": { "$ref": "#/entities/UserProjectSummary" },
      "description": "Per-user workspace repository summaries synchronized with the local AST indexer."
    }
  }
}
