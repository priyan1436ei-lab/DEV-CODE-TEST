# PORT: Local Express server port (default 3000)
PORT="3000"

# APP_URL: Public URL where DevMind AI is hosted (used for OAuth callbacks and OpenRouter Referer)
APP_URL="http://localhost:3000"

# Optional Desktop Google OAuth 2.0 Client ID (Desktop/Native app type) for System Browser PKCE sign-in
GOOGLE_DESKTOP_OAUTH_CLIENT_ID=
GOOGLE_DESKTOP_OAUTH_CLIENT_SECRET=

# Optional GitHub OAuth App credentials for one-click GitHub OAuth sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
